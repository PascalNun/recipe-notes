---
import type { RecipeEntry } from '../lib/recipes';
import { getRecipeUrl } from '../lib/recipes';
import { getDictionary } from '../i18n';
import AssetImageWithFallback from './AssetImageWithFallback.astro';

interface Props {
	recipe: RecipeEntry;
}

const { recipe } = Astro.props;
const { data } = recipe;
const dictionary = getDictionary(data.lang);
---

<article class="recipe-card">
	<a href={getRecipeUrl(recipe)} class="recipe-card__image" tabindex="-1" aria-hidden="true">
		<AssetImageWithFallback
			src={data.heroImage}
			alt=""
			label={dictionary.imageFallback}
			variant="card"
		/>
	</a>
	<div class="recipe-card__content">
		<p class="recipe-card__kicker">{dictionary.featuredRecipe}</p>
		<h2><a href={getRecipeUrl(recipe)}>{data.title}</a></h2>
		<p class="recipe-card__subtitle">{data.subtitle}</p>
		<p>{data.description}</p>
		<ul class="tag-list" aria-label="Tags">
			{data.tags.map((tag) => <li>{tag}</li>)}
		</ul>
		<a class="text-link" href={getRecipeUrl(recipe)}>{dictionary.viewRecipe} <span aria-hidden="true">→</span></a>
	</div>
</article>
