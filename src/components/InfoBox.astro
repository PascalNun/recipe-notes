---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	items?: string[];
	text?: string;
	tone?: 'sage' | 'pink' | 'oat' | 'blue';
	icon?: string;
	decoration?: 'cup' | 'skyline' | 'sprig';
	artwork?: ImageMetadata;
	artworkAlt?: string;
}

const { title, items, text, tone = 'sage', icon = '♡', decoration, artwork, artworkAlt = '' } = Astro.props;
---

<aside class:list={['info-box', `info-box--${tone}`]}>
	<header>
		<h2>{title}</h2>
		<span aria-hidden="true">{icon}</span>
	</header>
	{items && (
		<ul>
			{items.map((item) => <li>{item}</li>)}
		</ul>
	)}
	{text && <p>{text}</p>}
	{artwork && (
		<figure class="info-box__artwork">
			<Image
				src={artwork}
				alt={artworkAlt}
				widths={[320, 480, 640]}
				sizes="(max-width: 608px) 58vw, 11rem"
				quality={80}
				loading="lazy"
			/>
		</figure>
	)}
	{decoration === 'cup' && (
		<svg class="info-box__decoration info-box__decoration--cup" viewBox="0 0 120 96" aria-hidden="true">
			<path d="M19 38c1 25 9 39 31 40 24 1 35-12 36-40" />
			<path d="M19 38c5-8 62-8 67 0-5 9-62 9-67 0Z" />
			<path d="M86 46c27-5 27 25 2 24M10 81c27 7 68 7 95-1" />
			<path d="M35 25c-7-8 6-12 0-20M54 25c-7-8 7-12 1-20" />
		</svg>
	)}
	{decoration === 'skyline' && (
		<svg class="info-box__decoration info-box__decoration--skyline" viewBox="0 0 220 92" aria-hidden="true">
			<path class="info-box__decoration-wash" d="M5 66c31-15 47-9 70-18 29-12 43-3 70-12 31-11 46-4 69 4l-3 42H8Z" />
			<path d="M3 80c34 2 60-2 92 0 45 3 79-2 122 1" />
			<path d="M13 80V65l14-4 13 4v15M46 80V49l19-5 18 5v31M89 80V61l14-4 15 4v19M124 80V39l20-7 19 7v41M169 80V57l18-5 20 6v22" />
			<path d="m52 49 12-12 13 11M131 38l3-12 6-5 7 17M181 55v-9m-5 3h11" />
			<path d="M20 70h7m26-10h7m11 0h6m19 10h7m29-17h7m14 0h6m19 16h8M58 70v7m14-7v7m62-25v8m14-8v8m34 11v7" />
			<path class="info-box__decoration-botanical" d="M200 47c-2-17 2-30 12-42m-9 27c-9-2-13-7-14-14 7 0 12 5 14 14m4-12c7-2 10-7 10-13-7 1-10 6-10 13" />
		</svg>
	)}
	{decoration === 'sprig' && (
		<svg class="info-box__decoration info-box__decoration--sprig" viewBox="0 0 100 120" aria-hidden="true">
			<path d="M48 111C45 78 53 48 75 15" />
			<path d="M53 82c-19-2-29-11-32-25 15 0 26 8 32 25ZM60 61c17-2 28-11 31-25-15 0-26 8-31 25ZM67 42c-12-5-18-14-17-26 12 4 18 13 17 26Z" />
		</svg>
	)}
</aside>
